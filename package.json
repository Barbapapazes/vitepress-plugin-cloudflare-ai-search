{
  "name": "vitepress-plugin-cloudflare-ai-search",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.4",
  "description": "Replace VitePress default-theme search with Cloudflare AI Search",
  "author": "Estéban Soubiran <esteban@soubiran.dev>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/Barbapapazes",
  "homepage": "https://github.com/Barbapapazes/vitepress-plugin-cloudflare-ai-search#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Barbapapazes/vitepress-plugin-cloudflare-ai-search.git"
  },
  "bugs": "https://github.com/Barbapapazes/vitepress-plugin-cloudflare-ai-search/issues",
  "keywords": [
    "cloudflare",
    "cloudflare-ai-search",
    "search",
    "vite",
    "vitepress",
    "vitepress-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown",
    "prepack": "pnpm run build",
    "release": "bumpp --sign"
  },
  "peerDependencies": {
    "vite": ">=5.4.21",
    "vitepress": "^2.0.0-alpha.20",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@cloudflare/ai-search-snippet": "0.0.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.1",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "eslint": "^10.12.0",
    "taze": "^20.0.2",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
